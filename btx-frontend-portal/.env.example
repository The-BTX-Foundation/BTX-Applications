# Supabase project URL (Settings > API > Project URL). Safe to expose to the
# browser -- it's just the endpoint, not a credential.
VITE_SUPABASE_URL=

# Supabase publishable/anon key (Settings > API > Project API keys). Safe to
# expose to the browser -- all access through this key is constrained by RLS
# policies on each table. NEVER put the service_role key here or anywhere in
# this app.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" to show the TestNavPanel dev-only navigation shortcut
# (see src/components/TestNavPanel.vue and src/App.vue). Leave blank/unset
# in production.
VITE_ENABLE_TEST_NAV=
