# Copy to .env.local for local work. Never commit real values.
#
# Sign-in backend: "mock" runs entirely in the browser with no network (any Terpmail address is "sent" a code;
# 123456 signs in, 000000 shows the expired-code screen, any other code shows the wrong-code screen).
# "supabase" uses the live project's email-code sign-in. Leave this out and the Portal picks "supabase" when both
# Supabase values below are set, and "mock" otherwise.
NEXT_PUBLIC_AUTH_MODE=

# The Supabase project (btx-platform) URL and its publishable (anon) key. Both are safe in the browser; the
# database's row-level security decides what a signed-in person can do. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where "BTX board member? Go to the Ops Hub" points. Leave empty to show the link as "#".
NEXT_PUBLIC_OPS_HUB_URL=
