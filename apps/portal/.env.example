# Copy to .env.local for local work. Both Supabase values are public by design (the database's row-level
# security decides what a signed-in person can do). Never put a service-role key anywhere in this app.
#
# Sign-in backend: "mock" runs entirely in the browser with no network (any Terpmail address is "sent" a code;
# 123456 signs in, 000000 shows the expired-code screen, any other code shows the wrong-code screen).
# "supabase" uses the live project's email-code sign-in. Leave this empty and the Portal picks "supabase" when both
# Supabase values below are set, and "mock" otherwise. To run the mock locally, leave the two Supabase values empty.
NEXT_PUBLIC_AUTH_MODE=

# The btx-platform project.
NEXT_PUBLIC_SUPABASE_URL=https://awiaebtqalcmfafvktwh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9K1-NijV5lSE_SoY-3_2Tg_bKYHQIuy

# Comma-separated addresses that may sign in without being @terpmail.umd.edu (for previews and testing).
# Leave empty in production.
NEXT_PUBLIC_PORTAL_TEST_EMAILS=

# Where "BTX board member? Go to the Ops Hub" points. Leave empty to link back to sign-in for now.
NEXT_PUBLIC_OPS_HUB_URL=
