.env*
!.env.example
.vercel

# Secrets/credentials that aren't .env-named -- defense in depth beyond the
# .env* rule above, in case a key/cert/credential file ever lands here.
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
service-account*.json

